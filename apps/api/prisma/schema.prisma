generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("VIEWER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdCompanies Company[]  @relation("CreatedCompanies")
  updatedCompanies Company[]  @relation("UpdatedCompanies")
  createdDirectors Director[] @relation("CreatedDirectors")
  updatedDirectors Director[] @relation("UpdatedDirectors")
}

model Company {
  id               String   @id @default(cuid())
  cin              String   @unique
  name             String
  type             String
  companyClass     String
  nonClient        Boolean  @default(false)
  status           String   @default("active")
  registrationDate DateTime?
  contactEmail     String?
  contactPhone     String?
  registeredAddress String?
  city             String?
  state            String?
  pincode          String?
  panNumber        String?
  gstNumber        String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdById      String
  updatedById      String

  createdBy User @relation("CreatedCompanies", fields: [createdById], references: [id])
  updatedBy User @relation("UpdatedCompanies", fields: [updatedById], references: [id])

  @@index([name])
  @@index([cin])
}

model Director {
  id          String   @id @default(cuid())
  din         String   @unique
  name        String
  email       String?
  phone       String?
  status      String   @default("active")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  updatedById String

  createdBy User @relation("CreatedDirectors", fields: [createdById], references: [id])
  updatedBy User @relation("UpdatedDirectors", fields: [updatedById], references: [id])

  @@index([name])
  @@index([din])
}
